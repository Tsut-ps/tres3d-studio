"<script setup lang="ts">
import { shallowRef } from 'vue'
import { useLoop } from '@tresjs/core'
import { OrbitControls } from '@tresjs/cientos'
import { BloomPmndrs, ChromaticAberrationPmndrs, EffectComposerPmndrs, VignettePmndrs } from '@tresjs/post-processing'
import StudioEnv from './StudioEnv'

const { onBeforeRender } = useLoop()

const obj1 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj1.value
  if (!o) return
  const rot = [0, 0, 0]
  // くるくる回す
  rot[2] += 0.4 * elapsed
  o.rotation.set(rot[0], rot[1], rot[2])
})

const obj2 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj2.value
  if (!o) return
  const rot = [0, 0, 0]
  // くるくる回す
  rot[0] += 0.2 * elapsed
  rot[1] += 0.5 * elapsed
  o.rotation.set(rot[0], rot[1], rot[2])
})
</script>

<template>
  <TresPerspectiveCamera :position="[0, 1.5, 8]" :look-at="[0, 0, 0]" make-default />
  <OrbitControls make-default auto-rotate :auto-rotate-speed="1.2" />
  <TresFog :args="['#050510', 8, 30]" attach="fog" />
  <StudioEnv :intensity="0.8" />
  <TresPointLight :position="[0, 2, 3]" :intensity="80" :distance="0" :decay="2" color="#7aa2ff" />
  <TresMesh :position="[0, 0, -2.5]" cast-shadow receive-shadow ref="obj1">
    <TresTorusGeometry :args="[2.4, 0.12, 12, 96, 6.28319, 0, 6.28319]" />
    <TresMeshStandardMaterial color="#ff4fa3" emissive="#ff4fa3" :emissive-intensity="2.5" />
  </TresMesh>
  <TresMesh :position="[-1.6, 0, 0]" cast-shadow receive-shadow>
    <TresSphereGeometry :args="[1, 64, 48, 0, 6.28319, 0, 3.14159]" />
    <TresMeshPhysicalMaterial
      color="#ffffff"
      :roughness="0.05"
      :metalness="0"
      :transmission="1"
      :thickness="1.2"
      :ior="1.5"
    />
  </TresMesh>
  <TresMesh :position="[1.6, 0, 0]" cast-shadow receive-shadow ref="obj2">
    <TresIcosahedronGeometry :args="[1, 1]" />
    <TresMeshPhysicalMaterial
      color="#9fe8ff"
      :roughness="0.1"
      :transmission="1"
      :thickness="1.5"
      :ior="1.7"
      :iridescence="1"
    />
  </TresMesh>
  <Suspense>
    <EffectComposerPmndrs>
    <BloomPmndrs :intensity="1.2" :luminance-threshold="0.6" mipmap-blur />
    <VignettePmndrs :darkness="0.6" :offset="0.3" />
    <ChromaticAberrationPmndrs :offset="[0.0012, 0.0008]" />
    </EffectComposerPmndrs>
  </Suspense>
</template>
"
`;

exports[`サンプルの書き出し > ガラスと発光 > StudioEnv.ts 1`] = `
"import { defineComponent, onBeforeUnmount, onMounted, unref, watch } from 'vue'
import * as THREE from 'three'
import { useTres } from '@tresjs/core'
import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js'

/**
 * 通信不要のスタジオ環境光。three.js 付属の RoomEnvironment から環境マップを作り、
 * scene.environment に設定する。金属やガラスの映り込みに使う。
 */
const StudioEnv = defineComponent({
  name: 'StudioEnv',
  props: {
    intensity: { type: Number, default: 1 },
    background: { type: Boolean, default: false },
    blurriness: { type: Number, default: 0 },
    backgroundIntensity: { type: Number, default: 1 },
  },
  setup(props) {
    const ctx: any = useTres()
    let target: THREE.WebGLRenderTarget | null = null
    let prevEnv: THREE.Texture | null = null
    let prevBg: any = null

    const getScene = (): THREE.Scene | undefined => unref(ctx.scene)
    const getRenderer = (): any => {
      const r = unref(ctx.renderer)
      return r?.instance ? unref(r.instance) : r
    }

    function apply() {
      const scene: any = getScene()
      if (!scene || !target) return
      scene.environment = target.texture
      scene.environmentIntensity = props.intensity
      if (props.background) {
        scene.background = target.texture
        scene.backgroundBlurriness = props.blurriness
        scene.backgroundIntensity = props.backgroundIntensity
      } else if (scene.background === target.texture) {
        scene.background = prevBg
      }
    }

    onMounted(() => {
      const renderer = getRenderer()
      const scene: any = getScene()
      if (!renderer || !scene) return
      prevEnv = scene.environment
      prevBg = scene.background
      const pmrem = new THREE.PMREMGenerator(renderer)
      const room = new RoomEnvironment()
      target = pmrem.fromScene(room, 0.04)
      pmrem.dispose()
      room.dispose?.()
      apply()
    })
    watch(
      () => [props.intensity, props.background, props.blurriness, props.backgroundIntensity],
      apply,
    )
    onBeforeUnmount(() => {
      const scene: any = getScene()
      if (scene && target) {
        if (scene.environment === target.texture) scene.environment = prevEnv
        if (scene.background === target.texture) scene.background = prevBg
      }
      target?.dispose()
    })
    return () => null
  },
})

export default StudioEnv
"
`;

