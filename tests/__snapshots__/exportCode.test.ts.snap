exports[`サンプルの書き出し > 惑星の軌道 > Scene.vue 1`] = `
"<script setup lang="ts">
import { shallowRef } from 'vue'
import { useLoop } from '@tresjs/core'
import { OrbitControls, Stars } from '@tresjs/cientos'
import { BloomPmndrs, EffectComposerPmndrs } from '@tresjs/post-processing'
import { DoubleSide } from 'three'

const { onBeforeRender } = useLoop()

const obj1 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj1.value
  if (!o) return
  let k = 1
  // 拡大縮小をくり返す
  k *= 1 + 0.03 * Math.sin(elapsed * Math.PI * 2 * 0.6)
  o.scale.set(1 * k, 1 * k, 1 * k)
})

const obj2 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj2.value
  if (!o) return
  const pos = [0, 0.5, 0]
  // まわりを周回する
  {
    const a = elapsed * 1.1 + 0
    pos[0] = 0; pos[1] = 0; pos[2] = 0
    pos[0] += Math.cos(a) * 3
    pos[2] += Math.sin(a) * 3
  }
  o.position.set(pos[0], pos[1], pos[2])
})

const obj3 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj3.value
  if (!o) return
  const pos = [0, 0.5, 0]
  // まわりを周回する
  {
    const a = elapsed * 0.7 + 1.5
    pos[0] = 0; pos[1] = 0; pos[2] = 0
    pos[0] += Math.cos(a) * 5
    pos[2] += Math.sin(a) * 5
  }
  o.position.set(pos[0], pos[1], pos[2])
})

const obj4 = shallowRef()
onBeforeRender(({ elapsed }) => {
  const o = obj4.value
  if (!o) return
  const pos = [0, 0, 0]
  // まわりを周回する
  {
    const a = elapsed * 0.4 + 3
    pos[0] = 0; pos[1] = 0; pos[2] = 0
    pos[0] += Math.cos(a) * 8
    pos[2] += Math.sin(a) * 8
  }
  o.position.set(pos[0], pos[1], pos[2])
})
</script>

<template>
  <TresPerspectiveCamera :position="[0, 9, 13]" :look-at="[0, 0, 0]" make-default />
  <OrbitControls make-default />
  <Stars :count="4000" :size="0.12" />
  <TresAmbientLight :intensity="0.15" />
  <TresPointLight :position="[0, 0, 0]" :intensity="600" :distance="0" :decay="2" color="#ffd27a" />
  <TresMesh :position="[0, 0, 0]" cast-shadow receive-shadow ref="obj1">
    <TresSphereGeometry :args="[1.1, 48, 32, 0, 6.28319, 0, 3.14159]" />
    <TresMeshBasicMaterial color="#ffcf5a" />
  </TresMesh>
  <TresMesh :position="[0, 0.5, 0]" cast-shadow receive-shadow ref="obj2">
    <TresSphereGeometry :args="[0.32, 32, 16, 0, 6.28319, 0, 3.14159]" />
    <TresMeshStandardMaterial color="#9aa5b4" :roughness="0.8" />
  </TresMesh>
  <TresMesh :position="[0, 0.5, 0]" cast-shadow receive-shadow ref="obj3">
    <TresSphereGeometry :args="[0.5, 32, 16, 0, 6.28319, 0, 3.14159]" />
    <TresMeshStandardMaterial color="#4cc3d9" :roughness="0.5" />
  </TresMesh>
  <TresGroup ref="obj4">
    <TresMesh :position="[0, 0, 0]" :cast-shadow="false" receive-shadow>
      <TresSphereGeometry :args="[0.8, 40, 28, 0, 6.28319, 0, 3.14159]" />
      <TresMeshStandardMaterial color="#f0b429" :roughness="0.6" />
    </TresMesh>
    <TresMesh :position="[0, 0, 0]" :cast-shadow="false" receive-shadow :rotation="[-1.1708, 0, 0]">
      <TresRingGeometry :args="[1.2, 1.9, 64, 1, 0, 6.28319]" />
      <TresMeshBasicMaterial color="#e7d3a1" :side="DoubleSide" transparent :opacity="0.8" />
    </TresMesh>
  </TresGroup>
  <Suspense>
    <EffectComposerPmndrs>
    <BloomPmndrs :intensity="0.9" :luminance-threshold="0.8" mipmap-blur />
    </EffectComposerPmndrs>
  </Suspense>
</template>
"
`;

