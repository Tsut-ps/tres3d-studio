{
  "name": "tres3d-studio",
  "version": "1.0.0",
  "description": "ブロックを積んで TresJS のシーンを組み立て、その場でプレビューできるツール（非公式）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tsut-ps/tres3d-studio.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tresjs/cientos": "^5.10.0",
    "@tresjs/core": "^5.10.0",
    "@tresjs/post-processing": "^3.11.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
